{
  "expo": {
    "name": "FriendChise Mobile",
    "slug": "friendchise-mobile-app",
    "scheme": "friendchise",
    "version": "1.0.0",
    "icon": "./public/LOGO.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b1f4a647-401f-4141-b16d-dc7f585ea223"
      }
    },
    "ios": {
      "bundleIdentifier": "com.ivantran2001.friendchisemobileapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow FriendChise to take photos for task images.",
        "NSPhotoLibraryUsageDescription": "Allow FriendChise to pick task images from your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Allow FriendChise to save task images to your photo library."
      }
    },
    "android": {
      "package": "com.ivantran2001.friendchisemobileapp"
    }
  }
}
