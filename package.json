    "deps": "^1.0.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.7",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "htmlparser2": "^10.1.0",
    "lucide-react-native": "^1.24.0",
    "markdown-it": "^14.3.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
